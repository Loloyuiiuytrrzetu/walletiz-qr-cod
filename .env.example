# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE
VAPID_SUBJECT=mailto:admin@walletiz.app

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron worker
CRON_SECRET=change-me

# Google Wallet (Loyalty)
# 1. Créer un service account dans Google Cloud
# 2. Activer Google Wallet API
# 3. Inscrire le service account comme "Issuer" sur pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=3388000000000000000
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=walletiz@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Apple Wallet (PassKit)
# 1. Compte Apple Developer
# 2. Créer un Pass Type ID
# 3. Télécharger le certificat .p12 + le WWDR
APPLE_PASS_TYPE_ID=pass.com.walletiz.loyalty
APPLE_TEAM_ID=ABCDE12345
APPLE_PASS_CERT_PATH=./certs/pass.p12
APPLE_PASS_CERT_PASSWORD=your-cert-password
APPLE_WWDR_PATH=./certs/wwdr.pem
